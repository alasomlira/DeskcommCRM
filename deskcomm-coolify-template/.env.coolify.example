# Paste these values in Coolify > Environment Variables. Keep all secrets locked.
# Copy the remaining app settings from DeskcommCRM/.env.hostgator.example.

TUNNEL_NETWORK=coolify
TUNNEL_APP_ALIAS=deskcommcrm-app
# Docker network where the existing Redis container is reachable.
REDIS_NETWORK=coolify
# Use a separate logical database from n8n (for example /2), never n8n's DB.
EXTERNAL_REDIS_URL=redis://:PASSWORD@redis-container:6379/2

DOMAIN=crm.example.com
NEXT_PUBLIC_APP_URL=https://crm.example.com
NEXT_PUBLIC_ADMIN_URL=https://crm.example.com
NODE_ENV=production

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=

OWNER_EMAIL=admin@example.com
OWNER_PASSWORD=
APP_LOCALE=pt-BR

# Memória do Node somente enquanto o Coolify compila a imagem do app.
# Use 4096 em servidor com ao menos 8 GB livres durante o deploy.
NODE_HEAP_MB=4096
WORKER_IMAGE=ghcr.io/melgarafael/deskcomm-worker:stable
SCHEDULER_IMAGE=ghcr.io/melgarafael/deskcomm-scheduler:stable
WAHA_IMAGE=devlikeapro/waha:latest-2026.7.2

INTERNAL_SECRET=
# 32 bytes base64: openssl rand -base64 32
CPF_ENCRYPTION_KEY=
# 32 bytes hex: openssl rand -hex 32
WAHA_BYO_ENCRYPTION_KEY=
# 32 bytes base64: openssl rand -base64 32
AI_CRED_AES_KEY=

# Internal Docker addresses. Do not replace these with the public domain.
WAHA_API_BASE_URL=http://waha:3000
WAHA_WEBHOOK_BASE_URL=http://app:3000

# DeskcommCRM speaks the Upstash REST protocol through the local srh bridge.
UPSTASH_REDIS_REST_URL=http://srh:80
# Set this to exactly the same value as SRH_TOKEN.
UPSTASH_REDIS_REST_TOKEN=
SRH_TOKEN=
WAHA_HMAC_SECRET=
# Plain key used by the CRM to call WAHA. Keep it locked in Coolify.
WAHA_API_KEY=
# SHA-512 of WAHA_API_KEY, used by the WAHA container.
WAHA_API_KEY_SHA512=

# Marca exibida no título da aba e no favicon gerado pelo CRM.
APP_NAME="Brum - CRM"
APP_ACCENT_HEX="#86a77f"

