# Paste these values in Coolify > Environment Variables. Keep all secrets locked.
# Copy the remaining app settings from DeskcommCRM/.env.hostgator.example.

TUNNEL_NETWORK=coolify
TUNNEL_APP_ALIAS=deskcommcrm-app
# Docker network where the existing Redis container is reachable.
REDIS_NETWORK=coolify
# Use a separate logical database from n8n (for example /2), never n8n's DB.
EXTERNAL_REDIS_URL=redis://:PASSWORD@redis-container:6379/2

DOMAIN=crm.example.com
NEXT_PUBLIC_APP_URL=https://crm.example.com
NEXT_PUBLIC_ADMIN_URL=https://crm.example.com
WAHA_WEBHOOK_BASE_URL=https://crm.example.com

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=

OWNER_EMAIL=admin@example.com
OWNER_PASSWORD=
APP_LOCALE=pt-BR

APP_IMAGE=ghcr.io/melgarafael/deskcommcrm:stable
WORKER_IMAGE=ghcr.io/melgarafael/deskcomm-worker:stable
SCHEDULER_IMAGE=ghcr.io/melgarafael/deskcomm-scheduler:stable
WAHA_IMAGE=devlikeapro/waha:latest-2026.7.2

INTERNAL_SECRET=
SRH_TOKEN=
WAHA_HMAC_SECRET=
# Plain key used by the CRM to call WAHA. Keep it locked in Coolify.
WAHA_API_KEY=
# SHA-512 of WAHA_API_KEY, used by the WAHA container.
WAHA_API_KEY_SHA512=

